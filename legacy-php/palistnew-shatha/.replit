modules = ["php-8.2", "nodejs-20", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MariaDB"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Backend"

[[workflows.workflow]]
name = "MariaDB"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start_mariadb.sh"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start_nginx.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "PHP Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PHP_CLI_SERVER_WORKERS=8 php -d mysqli.default_socket=/run/mysqld/mysqld.sock -d display_errors=0 -S 127.0.0.1:8080 router.php"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/start_production.sh"]
