# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

############################
# Build output
############################
dist/
tmp/
out-tsc/
*.tsbuildinfo

############################
# Expo
############################
.expo/
.expo-shared/

############################
# Node / dependencies
############################
node_modules/

############################
# IDEs and editors
############################
/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

############################
# Coverage / testing
############################
/coverage/
/test-results/

############################
# Misc logs
############################
*.log
npm-debug.log
yarn-error.log
testem.log
libpeerconnection.log
connect.lock

############################
# Typings
############################
/typings/

############################
# System files
############################
.DS_Store
Thumbs.db

############################
# Cursor rules / helper docs (if generated)
############################
.cursor/

############################
# GitHub agent instructions (keep if you want them tracked)
############################
.github/instructions/

############################
# Replit
############################
.cache/
.local/

############################
# Generated artifacts (frontend/backend builds)
# NOTE: do NOT ignore the whole artifacts/ tree — it holds tracked source
# for both syndicate-web and api-server that the Vercel build depends on.
# Build outputs are already ignored via dist/ above.
############################

############################
# Local environment files (never commit real/local values)
############################
.env
.env.local
.env.*.local

############################
# Local uploads / attachments (generated by the CMS at runtime)
############################
attached_assets/uploads/

############################
# Runtime logs
############################
php-server.out.log
php-server.err.log

